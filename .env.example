# Copy this file to .env, then set the database password and SECRET_KEY.
APP_NAME=CogniCortex
DATABASE_URL=postgresql+psycopg://cognicortex:change-me@localhost:5432/cognicortex
REDIS_URL=redis://localhost:6379/0
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
